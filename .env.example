# Database Configuration
MYSQL_DATABASE=pho_bo_management
MYSQL_USER=pho_bo_user
MYSQL_PASSWORD=<your_mysql_password>
MYSQL_ROOT_PASSWORD=<your_mysql_root_password>
PHPMYADMIN_PORT=8082

# Spring Boot Datasource Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/pho_bo_management?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=pho_bo_user
SPRING_DATASOURCE_PASSWORD=<your_mysql_password>

# JWT Configuration
# Hex string recommended (e.g. 512-bit HS512 secret)
JWT_ACCESS_SECRET=<generate-a-strong-secret-locally>
JWT_REFRESH_SECRET=<generate-a-different-strong-secret-locally>
# 15 minutes (900000ms)
JWT_ACCESS_EXPIRATION=900000
# 7 days (604800000ms)
JWT_REFRESH_EXPIRATION=604800000

# Cookie Configuration
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Server Ports
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Frontend environment
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Environment
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# Database Configuration (Docker & Local)
DB_USER=postgres
DB_PASSWORD=postgres_password_123
DB_NAME=phobo_db
DB_PORT=5432
ADMINER_PORT=8080

# Prisma Database Connection URL
DATABASE_URL=postgresql://postgres:postgres_password_123@localhost:5432/phobo_db?schema=public

# JWT Credentials
JWT_ACCESS_SECRET=development_access_token_secret_key_12345!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=development_refresh_token_secret_key_67890!
JWT_REFRESH_EXPIRES_IN=7d

# Cookies Configuration
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Development Seed Accounts
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPassword@123
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=ManagerPassword@123
STAFF_EMAIL=staff@example.com
STAFF_PASSWORD=StaffPassword@123
CUSTOMER_EMAIL=customer@example.com
CUSTOMER_PASSWORD=CustomerPassword@123

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
